{
  "$schema": "https://opencode.ai/config.json",
  "instructions": ["AGENTS.md"],
  "mcp": {
    "servers": {
      "goca": {
        "type": "local",
        "command": ["goca", "mcp-server"],
        "cwd": ".",
        "timeout": {
          "startup": 30000,
          "catalog": 30000
        }
      }
    }
  },
  "permissions": [
    { "action": "shell", "resource": "make db-reset *", "effect": "deny" }
  ]
}
